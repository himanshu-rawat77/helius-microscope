    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Top Decoded Instructions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10, solana_microscope_instruction_count)",
          "legendFormat": "{{instruction}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Cumulative Fees Paid (SOL)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "solana_microscope_fee_lamports_total / 1000000000",
          "legendFormat": "Total Fees (SOL)",
          "refId": "A"
        }
