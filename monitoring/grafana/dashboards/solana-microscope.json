      "type": "timeseries",
      "targets": [
        {
          "expr": "solana_microscope_tps",
          "legendFormat": "Windowed TPS",
          "refId": "A"
        },
        {
          "expr": "rate(solana_microscope_tx_failed_total[1m])",
          "legendFormat": "Failed / sec",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        }
