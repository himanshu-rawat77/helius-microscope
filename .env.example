# =====================================================================
# Helius LaserStream Solana Indexer Configuration (Devnet)
# =====================================================================

# (Required) Your Helius API Key
# Get an API key at: https://dashboard.helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# (Optional) Helius Laserstream Devnet Endpoint
# Default: https://laserstream-devnet-ewr.helius-rpc.com
HELIUS_ENDPOINT=https://laserstream-devnet-ewr.helius-rpc.com

# (Optional) Target Program ID to stream transactions and accounts for
# Examples on Devnet:
# - SPL Memo Program : MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr
# - SPL Token Program: TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
PROGRAM_ID=MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr

# (Optional) Commitment level: CONFIRMED | PROCESSED | FINALIZED
COMMITMENT=CONFIRMED

# (Optional) Local SQLite Database file path
DATABASE_PATH=./indexer.db

# (Optional) Enable automatic slot tracking and historical replay on reconnects
REPLAY=true

# (Optional) Stream every intermediate intra-slot state update instead of latest
INTRA_SLOT_UPDATES=false
