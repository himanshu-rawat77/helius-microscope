# =====================================================================
# Solana Microscope Local & Helius LaserStream Configuration
# =====================================================================

# (Required) Your Helius API Key with LaserStream access
# Get an API key at: https://dashboard.helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# (Optional) Target Solana Network: devnet | mainnet
# Default: devnet
NETWORK=devnet

# (Optional) Helius LaserStream Endpoint
# Automatically selects the default based on NETWORK:
# - Devnet:  https://laserstream-devnet-ewr.helius-rpc.com
# - Mainnet: https://laserstream-mainnet-ewr.helius-rpc.com
#
# Mainnet Regional Options:
# - US East (Newark)     : https://laserstream-mainnet-ewr.helius-rpc.com
# - US West (Salt Lake)  : https://laserstream-mainnet-slc.helius-rpc.com
# - Europe (Frankfurt)   : https://laserstream-mainnet-fra.helius-rpc.com
# - Asia (Tokyo)         : https://laserstream-mainnet-tyo.helius-rpc.com
# HELIUS_ENDPOINT=https://laserstream-devnet-ewr.helius-rpc.com

# (Optional) Target Program ID to stream and monitor
# Devnet Examples:
# - SPL Memo Program         : MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr
# - SPL Token Program        : TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
# - Associated Token Program : ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL
#
# Mainnet Examples:
# - Raydium AMM V4           : 675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8
# - Pump.fun Program         : 6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
# - Whirlpools (Orca)        : whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc
# - SPL Token Program        : TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA

# (Optional) Monitor MULTIPLE Programs simultaneously (comma-separated, overrides PROGRAM_ID)
# PROGRAM_IDS=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA,ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL

# (Optional) Monitor Squads / Multisig PDA addresses (comma-separated)
# MULTISIG_ADDRESSES=SQDS4ep65T869zMMBKyuUq6aD6EgTu8psMjkvj52pCf

# (Optional) Automatic RPC + Yellowstone gRPC Failover
RPC_FAILOVER_ENABLED=true
RPC_POLL_INTERVAL_MS=3000
# HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# (Optional) Port for Microscope Local Web Dashboard (default: 3000)
MICROSCOPE_PORT=3000

# (Optional) Path to local Anchor IDL JSON file for decoded instructions & events
IDL_PATH=./idl.json

# (Optional) Commitment level: CONFIRMED | PROCESSED | FINALIZED
COMMITMENT=CONFIRMED

# (Optional) Local SQLite Database file path
DATABASE_PATH=./indexer.db

# (Optional) Enable automatic slot tracking and historical replay on reconnects
REPLAY=true

# (Optional) Stream every intermediate intra-slot state update instead of latest
INTRA_SLOT_UPDATES=false
